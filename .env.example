ANTHROPIC_API_KEY=

# Optional — enables a per-IP daily scan cap (8/day) and short share links
# (yoursite.com/s/xxxxxxx instead of a long hash URL, expiring after
# SHARE_LINK_TTL_DAYS). Without these, the app works fine — no rate
# limiting, and share links just stay long. Free tier at upstash.com:
# create a Redis database, copy the REST URL/token from its dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
